# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret - use a strong random string in production
JWT_SECRET=your-secure-random-secret-here

# Environment
NODE_ENV=production

# Port (Railway provides this automatically via PORT env var)
PORT=3001

# CORS origins (comma-separated, only needed if client is on a different domain)
# CORS_ORIGIN=https://your-app.railway.app

# Mapbox token for satellite imagery and 3D terrain (client-side, baked into Vite build)
# Get a free token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
